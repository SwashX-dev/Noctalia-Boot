{ config, lib, pkgs, ... }:
let
  cfg = config.programs.noctalia-switch-os;
  chord = lib.types.strMatching "[A-Za-z0-9_]+(\\+[A-Za-z0-9_]+)*";
  bindsFile = pkgs.writeText "noctalia-switch-os-niri-binds.kdl" ''
    // Generated by the noctalia-switch-os NixOS module.
    binds {
        ${cfg.keybinding} hotkey-overlay-title="Switch operating system" { spawn "noctalia" "msg" "panel-toggle" "local/switch-os:switcher"; }
    }
  '';
in
{
  options.programs.noctalia-switch-os = {
    enable = lib.mkEnableOption "the Noctalia Switch OS plugin (one-time systemd-boot selection)";
    package = lib.mkOption {
      type = lib.types.package;
      default = pkgs.callPackage ./package.nix { };
      defaultText = lib.literalExpression "pkgs.callPackage ./package.nix { }";
      description = "The noctalia-switch-os package.";
    };
    keybinding = lib.mkOption {
      type = chord;
      default = "Mod+Shift+P";
      description = "Niri key chord written to /etc/noctalia-switch-os/niri-binds.kdl.";
    };
    installNiriBindings = lib.mkOption {
      type = lib.types.bool;
      default = true;
      description = ''
        Generate /etc/noctalia-switch-os/niri-binds.kdl. Niri reads it only after you add
        `include optional=true "/etc/noctalia-switch-os/niri-binds.kdl"` to your config
        (`noctalia-switch-os-setup apply` does this after checking for conflicts).
      '';
    };
  };

  config = lib.mkIf cfg.enable {
    warnings = lib.optional (!config.boot.loader.systemd-boot.enable)
      "programs.noctalia-switch-os: systemd-boot is not enabled; the switcher will explain that switching is unsupported and change nothing.";
    # PolicyKit provides the authentication prompt; the package ships two
    # narrowly scoped actions bound to fixed executables in the Nix store.
    security.polkit.enable = true;
    environment.systemPackages = [ cfg.package ];
    environment.pathsToLink = [ "/share/noctalia-switch-os" ];
    environment.etc."noctalia-switch-os/niri-binds.kdl" = lib.mkIf cfg.installNiriBindings { source = bindsFile; };
  };
}
